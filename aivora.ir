# 1️⃣ TRAFFIC INTELLIGENCE ENGINE

تحلیل اینکه کاربران از کجا وارد سایت می‌شوند.

html
<script>
function v12TrafficSource(){

let ref=document.referrer;

let source="direct";

if(ref.includes("google")) source="google";
if(ref.includes("torob")) source="torob";
if(ref.includes("instagram")) source="instagram";
if(ref.includes("bing")) source="search";

localStorage.setItem("v12_source",source);

return source;

}
</script>


کاربرد:

- تشخیص ورودی
- شخصی‌سازی صفحه

---

# 2️⃣ USER BEHAVIOR AI v2

تحلیل رفتار کاربر برای افزایش فروش.

html
<script>
function v12BehaviorTracker(){

let data={
time:Date.now(),
scroll:0,
clicks:0
};

window.addEventListener("scroll",()=>{
data.scroll=window.scrollY;
});

window.addEventListener("click",()=>{
data.clicks++;
});

window.addEventListener("beforeunload",()=>{
localStorage.setItem("v12_behavior",JSON.stringify(data));
});

}
</script>


