# 8️⃣ V11 CONTROLLER  
اتصال همه چیز به هم

html
<script>
async function V11Start(){

const products = await v10LoadProducts();
if(!products.length) return;

const path = location.pathname;

// PRODUCT PAGE
if(path.startsWith("/product/")){
const slug=path.split("/")[2];
const current = products.find(p=>p.slug===slug);
if(!current) return;

v10InsertMainContent(current);
v10ApplyMetaForCTR(current);
v11RefreshMark();
return;
}

// CATEGORY PAGE
if(path.startsWith("/category/")){
const cat=path.split("/")[2];
v105BuildCategoryPage({title:cat,slug:cat},products);
v105CategorySchema({title:cat,slug:cat});
v11RefreshMark();
return;
}

// TAG PAGE
if(path.startsWith("/tag/")){
const keyword=decodeURIComponent(path.split("/")[2]);
v105TagPage(keyword,products);
v11ApplyDiscoverMeta(keyword);
v11InjectFAQ(keyword);
v11RefreshMark();
return;
}

// BLOG PAGE (AUTO-GENERATED)
if(path.startsWith("/blog/")){
const topic = decodeURIComponent(path.split("/")[2]);
v11AutoBlogBuilder(topic,products);
v11ApplyDiscoverMeta(topic);
v11InjectFAQ(topic);

const clusters = v11TopicExpansion(products);
v11SemanticLinks(clusters,products);

return;
}

}
document.addEventListener("DOMContentLoaded",V11Start);
</script>


