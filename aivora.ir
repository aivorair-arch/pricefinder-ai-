<script>
document.addEventListener("DOMContentLoaded", async function() {
    // تنظیمات فارسی
    document.documentElement.lang = "fa";
    document.documentElement.dir = "rtl";

    const url = window.location.href;
    const noIndexPages = ["cart","checkout","account","login","register"];
    const isNoIndex = noIndexPages.some(word => url.includes(word));

    // robots meta
    let robotsMeta = document.querySelector('meta[name="robots"]');
    if(!robotsMeta){
        robotsMeta = document.createElement("meta");
        robotsMeta.name = "robots";
        document.head.appendChild(robotsMeta);
    }
    robotsMeta.content = isNoIndex ? "noindex, nofollow" : "index, follow";

    // Open Graph خودکار
    function setOG(property, content){
        if(!document.querySelector(`meta[property="${property}"]`)){
            let meta = document.createElement("meta");
            meta.setAttribute("property", property);
            meta.content = content;
            document.head.appendChild(meta);
        }
    }

    const title = document.querySelector("h1") ? document.querySelector("h1").innerText : document.title;
    const image = document.querySelector("img") ? document.querySelector("img").src : "";
    const descMeta = document.querySelector("meta[name='description']");
    const description = descMeta ? descMeta.content : "";

    setOG("og:type","website");
    setOG("og:title", title);
    setOG("og:url", url);
    setOG("og:description", description || title);

    // اگر صفحه محصول است، اطلاعات محصول را از سایت بگیر و به API بفرست
    if(url.includes("/product/")){
        const priceEl = document.querySelector(".price, .product-price, [class*='price']");
        const price = priceEl ? priceEl.innerText.replace(/[^0-9]/g,'') : "";

        // ارسال به API برای تولید محتوا با ChatGPT
        try {
            const productData = { title: title, price: price, url: url };
            const response = await fetch("/api/auto-product-seo", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(productData)
            });
            const seoJSON = await response.json();

            // افزودن Meta Description و Keywords
            let metaDesc = document.querySelector('meta[name="description"]');
            if(!metaDesc){
                metaDesc = document.createElement("meta");
                metaDesc.name = "description";
                document.head.appendChild(metaDesc);
            }
            metaDesc.content = seoJSON.meta_description || title;

            let metaKeywords = document.querySelector('meta[name="keywords"]');
            if(!metaKeywords){
                metaKeywords = document.createElement("meta");
                metaKeywords.name = "keywords";
                document.head.appendChild(metaKeywords);
            }
            metaKeywords.content = seoJSON.seo_keywords || "";

            // افزودن Schema محصول
            const productSchema = {
                "@context":"https://schema.org",
                "@type":"Product",
                "name": title,
                "image": image,
                "description": seoJSON.description || description || title,
                "offers":{
                    "@type":"Offer",
                    "url": url,
                    "priceCurrency":"IRR",
                    "price": price,
                    "availability":"https://schema.org/InStock"
                },
                "brand":{"@type":"Brand","name":"لوازم خانگی"}
            };
            let schemaScript = document.createElement("script");
            schemaScript.type = "application/ld+json";
            schemaScript.text = JSON.stringify(productSchema);
            document.head.appendChild(schemaScript);

        } catch(e){
            console.error("خطا در تولید خودکار SEO:", e);
        }
    }
});
</script>import axios from "axios"
import cron from "node-cron"
import fs from "fs"

// خواندن محصولات از سایت خودت
async function fetchProducts() {
  const { data } = await axios.get("https://yourshop.com/api/products")
  return data
}

// تبدیل محصولات به فید ترب
function buildTorobFeed(products) {
  return products.map(p => ({
    id: p.id.toString(),
    title: p.title,
    price: p.price,
    url: `https://yourshop.com/product/${p.id}`,
    image_url: p.image,
    availability: p.stock > 0 ? "in stock" : "out of stock"
  }))
}

// اجرای خودکار هر 3 ساعت
cron.schedule("0 */3 * * *", async () => {
  const products = await fetchProducts()
  const feed = buildTorobFeed(products)
  fs.writeFileSync("/var/www/torob-feed.json", JSON.stringify(feed, null, 2))
  console.log("Feed updated!")
})

<script>
document.addEventListener("DOMContentLoaded", async function() {
    // --- تنظیمات اولیه و زبان سایت ---
    document.documentElement.lang = "fa";
    document.documentElement.dir = "rtl";

    const url = window.location.href;
    const currentPath = window.location.pathname;

    // صفحات مهم که نباید ایندکس شوند
    const noIndexPaths = ["/cart", "/checkout", "/account", "/login", "/register", "/search", "/admin"]; // اضافه شدن /admin
    const isNoIndex = noIndexPaths.some(path => currentPath.startsWith(path));

    // --- مدیریت Meta Robots ---
    let robotsMeta = document.querySelector('meta[name="robots"]');
    if (!robotsMeta) {
        robotsMeta = document.createElement("meta");
        robotsMeta.name = "robots";
        document.head.appendChild(robotsMeta);
    }
    robotsMeta.content = isNoIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large, canonical"; // اضافه شدن canonical

    // --- تنظیمات Open Graph (OG) خودکار ---
    function setOGMeta(property, content) {
        let meta = document.querySelector(`meta[property="${property}"]`);
        if (!meta) {
            meta = document.createElement("meta");
            meta.setAttribute("property", property);
            document.head.appendChild(meta);
        }
        meta.content = content;
    }

    // استخراج اطلاعات اصلی صفحه
    const pageTitle = document.querySelector("h1, h1.product-name, .product-title")?.innerText?.trim() || document.title;
    const primaryImageElement = document.querySelector("img.main-image, img[alt*='تصویر اصلی'], .product-image img, .product-image picture img");
    const pageImage = primaryImageElement ? primaryImageElement.src : "";
    const descriptionMetaElement = document.querySelector("meta[name='description']");
    let pageDescription = descriptionMetaElement?.content?.trim() || pageTitle; // اگر متا دیکریپشن نبود، عنوان صفحه رو بذار

    setOGMeta("og:type", currentPath.startsWith("/product/") ? "product" : "website");
    setOGMeta("og:title", pageTitle);
    setOGMeta("og:url", url);
    setOGMeta("og:description", pageDescription);
    if (pageImage) {
        setOGMeta("og:image", pageImage);
        // اضافه کردن og:image:secure_url اگر تصویر HTTPS هست
        if (pageImage.startsWith('https')) {
             setOGMeta("og:image:secure_url", pageImage);
        }
    }
    setOGMeta("og:locale", "fa_IR");

    // --- پردازش ویژه برای صفحات محصول ---
    if (currentPath.startsWith("/product/")) {
        try {
            // استخراج قیمت با پاکسازی بهتر
            const priceElement = document.querySelector(".price, .product-price, [class*='price'], .current-price, .sale-price");
            let priceRaw = priceElement ? priceElement.innerText.replace(/[^\d.,]/g, '').trim() : "";
            let price = "";
            if (priceRaw) {
                // حذف کاماها و تبدیل ممیز به نقطه برای فرمت عددی استاندارد
                priceRaw = priceRaw.replace(/,/g, '').replace('٫', '.').replace('،', '.'); // پشتیبانی از انواع جداکننده اعشار
                const parsedPrice = parseFloat(priceRaw);
                if (!isNaN(parsedPrice)) {
                    price = parsedPrice;
                }
            }
            const currency = "IRR"; // یا IRT اگر تومان هست

            // اضافه کردن داده‌های قیمت و ارز به OG Meta
            if (price) {
                setOGMeta("product:price:amount", price);
                setOGMeta("product:price:currency", currency);
            }

            // --- فراخوانی API برای سئو و اسکیما (اگر در دسترس باشد) ---
            const seoApiUrl = "/api/auto-product-seo"; // فرض می‌کنیم API شما در این مسیر است
            const productDataForApi = { title: pageTitle, price: price, url: url, description: pageDescription, image: pageImage };

            let seoData = null;
            try {
                const response = await fetch(seoApiUrl, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(productDataForApi)
                });

                if (response.ok) {
                    seoData = await response.json();

                    // آپدیت متا دیکریپشن و کلمات کلیدی
                    let metaDesc = document.querySelector('meta[name="description"]');
                    if (!metaDesc) {
                        metaDesc = document.createElement("meta");
                        metaDesc.name = "description";
                        document.head.appendChild(metaDesc);
                    }
                    metaDesc.content = seoData.meta_description || pageDescription;

                    let metaKeywords = document.querySelector('meta[name="keywords"]');
                    if (!metaKeywords) {
                        metaKeywords = document.createElement("meta");
                        metaKeywords.name = "keywords";
                        document.head.appendChild(metaKeywords);
                    }
                    metaKeywords.content = seoData.seo_keywords || "";

                    // آپدیت OG Description اگر API توضیحات بهتری داد
                    if (seoData.description) {
                        setOGMeta("og:description", seoData.description);
                        pageDescription = seoData.description; // برای استفاده در اسکیما
                    }
                } else {
                    console.warn("API سئو در دسترس نیست یا خطا دارد:", response.status);
                }
            } catch (fetchError) {
                console.error("خطا در فراخوانی API سئو:", fetchError);
            }

            // --- افزودن Schema Markup برای محصول ---
            const productSchema = {
                "@context": "https://schema.org",
                "@type": "Product",
                "name": pageTitle,
                "image": pageImage ? [pageImage] : [],
                "description": pageDescription,
                "sku": seoData?.sku || "",
                "brand": {
                    "@type": "Brand",
                    "name": seoData?.brand_name || document.querySelector('.brand-name')?.innerText?.trim() || "نام برند" // تلاش برای گرفتن نام برند از صفحه یا API
                },
                "offers": {
                    "@type": "Offer",
                    "url": url,
                    "priceCurrency": currency,
                    "price": price || seoData?.price || "",
                    // وضعیت موجودی را با دقت بیشتری تعیین کنید
                    "availability": seoData?.availability === 'in stock' ? "https://schema.org/InStock" : (seoData?.availability === 'out of stock' ? "https://schema.org/OutOfStock" : "https://schema.org/InStock"),
                    "seller": {
                        "@type": "Organization",
                        "name": "نام فروشگاه شما", // حتماً جایگزین کنید
                        "url": window.location.origin // آدرس سایت شما
                    }
                },
            };

            // حذف فیلدهای خالی و غیرضروری از اسکیما
            const cleanSchema = (schemaObj) => {
                Object.keys(schemaObj).forEach(key => {
                    if (schemaObj[key] === "" || schemaObj[key] === null || (typeof schemaObj[key] === 'object' && Object.keys(schemaObj[key]).length === 0)) {
                        delete schemaObj[key];
                    } else if (typeof schemaObj[key] === 'object') {
                        cleanSchema(schemaObj[key]); // بازگشتی برای اشیاء داخلی
                    }
                });
                return schemaObj;
            };

            const finalSchema = cleanSchema(productSchema);

            let schemaScript = document.createElement("script");
            schemaScript.type = "application/ld+json";
            schemaScript.textContent = JSON.stringify(finalSchema);
            document.head.appendChild(schemaScript);

        } catch (e) {
            console.error("خطا در پردازش صفحه محصول:", e);
        }
    } else {
        // --- برای صفحات غیر محصول (مثلا صفحه اصلی، دسته‌بندی) ---
        const organizationSchema = {
            "@context": "https://schema.org",
            "@type": "Organization",
            "url": window.location.origin,
            "name": "نام فروشگاه شما", // حتماً جایگزین کنید
            "logo": "آدرس لوگوی فروشگاه شما", // حتماً جایگزین کنید
            "contactPoint": {
                "@type": "ContactPoint",
                "telephone": "+98xxxxxxxxxx", // شماره تماس خودتان را وارد کنید
                "contactType": "Customer service",
                "areaServed": "IR"
            }
        };
        let schemaScript = document.createElement("script");
        schemaScript.type = "application/ld+json";
        schemaScript.textContent = JSON.stringify(organizationSchema);
        document.head.appendChild(schemaScript);
    }

     // اضافه کردن تگ canonical
     let canonicalLink = document.querySelector("link[rel='canonical']");
     if (!canonicalLink) {
         canonicalLink = document.createElement("link");
         canonicalLink.rel = "canonical";
         document.head.appendChild(canonicalLink);
     }
     canonicalLink.href = url.split('?')[0]; // حذف پارامترهای URL در canonical
});
</script>
