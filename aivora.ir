    <meta property="og:description" content="لیست محصولات مرتبط با جستجوی '{{ search_query }}' در {{ site_name }}. قیمت، مشخصات و خرید آنلاین.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ current_url }}">
