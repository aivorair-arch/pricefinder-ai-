# 4️⃣ DYNAMIC LANDING PAGE ENGINE

ساخت صفحات فرود اتوماتیک برای تبلیغات.

مثال URL:


/landing/iphone-cheap


html
<script>
function v12LandingBuilder(keyword,products){

const results=products
.filter(p=>p.title.includes(keyword))
.slice(0,12);

let wrap=document.createElement("div");

wrap.className="v10-container";

wrap.innerHTML=`<h1>خرید ${keyword} با بهترین قیمت</h1>`;

results.forEach(p=>{
let el=document.createElement("div");

el.innerHTML=`<a href="/product/${p.slug}">${p.title}</a>`;

wrap.appendChild(el);

});

document.body.appendChild(wrap);

}
</script>


