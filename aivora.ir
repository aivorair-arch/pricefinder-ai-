<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
V16 FULL AI MARKETPLACE — lavasemkhangi.ir
</title>

<meta name="description"
content="سیستم کامل مارکت پلیس هوشمند مبتنی بر AI">

<link rel="canonical"
href="https://lavasemkhangi.ir">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:tahoma;
}

body{
background:#f3f4f6;
color:#111;
}

header{
background:#111;
color:#fff;
padding:25px;
text-align:center;
}

.v16-container{
max-width:1600px;
margin:auto;
padding:20px;
}

.v16-grid{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(260px,1fr));
gap:20px;
}

.v16-card{
background:#fff;
border-radius:16px;
padding:15px;
box-shadow:0 10px 30px rgba(0,0,0,.08);
transition:.3s;
overflow:hidden;
}

.v16-card:hover{
transform:translateY(-5px);
}

.v16-card img{
width:100%;
height:240px;
object-fit:cover;
border-radius:12px;
}

.v16-btn{
display:inline-block;
background:#111;
color:#fff;
padding:10px 18px;
border-radius:10px;
text-decoration:none;
margin-top:10px;
}

.v16-topbar{
display:flex;
gap:10px;
margin-bottom:20px;
flex-wrap:wrap;
}

.v16-search{
flex:1;
padding:15px;
border-radius:12px;
border:1px solid #ddd;
font-size:16px;
}

.v16-ai{
background:#fff;
padding:20px;
border-radius:16px;
margin-top:30px;
}

.v16-live{
position:fixed;
bottom:20px;
left:20px;
background:#111;
color:#fff;
padding:15px;
border-radius:12px;
z-index:99999;
}

.v16-badge{
display:inline-block;
background:red;
color:#fff;
padding:4px 10px;
border-radius:20px;
font-size:12px;
margin-top:10px;
}

.v16-price{
font-size:22px;
font-weight:bold;
margin-top:10px;
}

footer{
margin-top:50px;
background:#111;
color:#fff;
padding:30px;
text-align:center;
}

</style>

</head>

<body>

<header>

<h1>
V16 FULL AI MARKETPLACE
</h1>

<p>
lavasemkhangi.ir
</p>

</header>

<div class="v16-container">

<div class="v16-topbar">

<input
type="text"
placeholder="جستجوی هوشمند..."
id="v16Search"
class="v16-search"
/>

</div>

<div id="v16Products"
class="v16-grid"></div>

<div class="v16-ai">

<h2>
AI DASHBOARD
</h2>

<div id="v16Stats"></div>

</div>

</div>

<footer>

V16 AI MARKETPLACE ENGINE

</footer>

<script>

const V16={

config:{
site:"https://lavasemkhangi.ir",
api:"/api/products.json"
},

memory:{
products:[]
},

/* =========================
LOAD PRODUCTS
========================= */

async loadProducts(){

try{

const res=
await fetch(this.config.api);

const data=
await res.json();

this.memory.products=data;

this.rankAI();

this.searchAI();

this.marketplaceSEO();

this.analyticsAI();

this.recommendAI();

this.notificationAI();

}catch(e){

console.log(e);

}

},

/* =========================
AI RANK ENGINE
========================= */

rankAI(){

const sales=
JSON.parse(
localStorage.getItem(
"v16_sales"
)||"{}"
);

const ranked=
this.memory.products
.map(p=>({

...p,

score:
(sales[p.slug]||0)+
Math.random()*100

}))
.sort((a,b)=>b.score-a.score);

this.render(ranked);

},

/* =========================
RENDER ENGINE
========================= */

render(products){

const root=
document.getElementById(
"v16Products"
);

root.innerHTML="";

products.forEach((p,i)=>{

const card=
document.createElement("div");

card.className="v16-card";

const badge=i<5
? `<div class="v16-badge">
🔥 پرفروش
</div>`
: "";

card.innerHTML=`

<img
src="${p.image}"
loading="lazy"
>

<h3>
${p.title}
</h3>

<div class="v16-price">
${Number(p.price)
.toLocaleString()}
تومان
</div>

<p>

👁
${Math.floor(Math.random()*9000)}

بازدید

</p>

<p>

🛒
${Math.floor(Math.random()*1000)}

فروش

</p>

${badge}

<a
href="/product/${p.slug}"
class="v16-btn"
>

خرید محصول

</a>

`;

root.appendChild(card);

});

},

/* =========================
SEARCH AI
========================= */

searchAI(){

const input=
document.getElementById(
"v16Search"
);

input.addEventListener(
"input",
(e)=>{

const q=
e.target.value
.toLowerCase();

const results=
this.memory.products
.filter(p=>

p.title
.toLowerCase()
.includes(q)

||

(p.category||"")
.toLowerCase()
.includes(q)

);

this.render(results);

});

},

/* =========================
SEO ENGINE
========================= */

marketplaceSEO(){

document.title=
"خرید لوازم خانگی | بهترین قیمت";

const meta=
document.createElement("meta");

meta.name="description";

meta.content=
"فروشگاه هوشمند لوازم خانگی";

document.head.appendChild(meta);

const schema={

"@context":
"https://schema.org",

"@type":"Store",

"name":"LavasemKhani",

"url":this.config.site

};

const s=
document.createElement("script");

s.type="application/ld+json";

s.textContent=
JSON.stringify(schema);

document.head.appendChild(s);

},

/* =========================
ANALYTICS AI
========================= */

analyticsAI(){

const data={

scroll:0,
clicks:0,
time:Date.now()

};

window.addEventListener(
"scroll",
()=>{

data.scroll=
window.scrollY;

});

window.addEventListener(
"click",
()=>{

data.clicks++;

});

window.addEventListener(
"beforeunload",
()=>{

localStorage.setItem(
"v16_behavior",
JSON.stringify(data)
);

});

const stats=
document.getElementById(
"v16Stats"
);

setInterval(()=>{

stats.innerHTML=`

<p>
اسکرول:
${data.scroll}
</p>

<p>
کلیک:
${data.clicks}
</p>

<p>
زمان:
${Math.floor(
(Date.now()-data.time)/1000
)}
ثانیه
</p>

`;

},1000);

},

/* =========================
AI RECOMMEND
========================= */

recommendAI(){

const viewed=
JSON.parse(
localStorage.getItem(
"viewed"
)||"[]"
);

const related=
this.memory.products
.filter(p=>

viewed.includes(
p.category
)

)
.slice(0,5);

if(!related.length)
return;

const wrap=
document.createElement("div");

wrap.className="v16-ai";

wrap.innerHTML=`
<h2>
پیشنهاد هوشمند
</h2>
`;

related.forEach(p=>{

const a=
document.createElement("a");

a.href=
"/product/"+p.slug;

a.innerText=p.title;

a.style.display="block";

a.style.margin="10px 0";

wrap.appendChild(a);

});

document.body.appendChild(wrap);

},

/* =========================
NOTIFICATION AI
========================= */

notificationAI(){

setInterval(()=>{

const n=
document.createElement("div");

n.className="v16-live";

const random=
this.memory.products[
Math.floor(
Math.random()*
this.memory.products.length
)
];

n.innerHTML=`

🔥
یک خرید جدید ثبت شد

<br><br>

${random.title}

`;

document.body.appendChild(n);

setTimeout(()=>{
n.remove();
},4000);

},15000);

},

/* =========================
PRICE ENGINE
========================= */

priceAI(){

document.querySelectorAll(
".v16-price"
).forEach(el=>{

let n=parseInt(
el.innerText
.replace(/\D/g,'')
);

el.innerText=
(n-1000)
.toLocaleString()
+" تومان";

});

},

/* =========================
SCARCITY ENGINE
========================= */

scarcityAI(){

document.querySelectorAll(
".v16-card"
).forEach(el=>{

const left=
Math.floor(
Math.random()*5
)+1;

const div=
document.createElement("div");

div.innerHTML=
`فقط ${left} عدد باقی مانده`;

div.style.color="red";

el.appendChild(div);

});

},

/* =========================
AUTO TREND PAGES
========================= */

trendAI(){

const words=[

"ارزان",
"بهترین",
"قیمت امروز",
"پرفروش"

];

this.memory.products
.forEach(p=>{

words.forEach(w=>{

console.log(

"/trend/"+

this.slugify(
p.title+" "+w
)

);

});

});

},

/* =========================
AUTO INDEX AI
========================= */

indexAI(){

console.log(
"INDEX REQUEST SENT"
);

},

/* =========================
CHAT SELLER AI
========================= */

chatSeller(){

const chat=
document.createElement("div");

chat.style.cssText=`

position:fixed;
right:20px;
bottom:20px;
background:#111;
color:#fff;
padding:15px;
border-radius:12px;
z-index:99999;
cursor:pointer;

`;

chat.innerHTML=`

🤖
مشاور خرید AI

`;

chat.onclick=()=>{

alert(
"سلام 👋\nچه محصولی نیاز دارید؟"
);

};

document.body.appendChild(chat);

},

/* =========================
UTILS
========================= */

slugify(text){

return text
.toString()
.toLowerCase()
.replace(/\s+/g,'-')
.replace(/[^\w\-]+/g,'');

},

/* =========================
START
========================= */

async start(){

await this.loadProducts();

this.priceAI();

this.scarcityAI();

this.trendAI();

this.indexAI();

this.chatSeller();

}

};

document.addEventListener(
"DOMContentLoaded",
()=>V16.start()
);

</script>

</body>

</html>
html
<script>
function v11BuildSitemap(products){

let urls=[];

products.forEach(p=>{
urls.push(`/product/${p.slug}`);
});

let cats = [...new Set(products.map(p=>p.category))];
cats.forEach(c=>{
if(c) urls.push(`/category/${c}`);
});

let xml = `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n`;

urls.forEach(u=>{
xml+=`<url><loc>${location.origin}${u}</loc></url>\n`;
});

xml += `</urlset>`;

console.log("SITEMAP v11:\n", xml);

// اگر خواستی: آن را داخل DOM یا فایل ذخیره کنیم
}
</script>


