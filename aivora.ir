# 3️⃣ CONVERSION OPTIMIZER

اگر کاربر قصد خروج داشت → پیشنهاد ویژه.

html
<script>
function v12ExitIntent(product){

document.addEventListener("mouseout",function(e){

if(e.clientY<10){

const box=document.createElement("div");

box.style.cssText="position:fixed;bottom:0;left:0;width:100%;background:#111;color:#fff;padding:15px;text-align:center;z-index:9999";

box.innerHTML=`
10٪ تخفیف ویژه برای ${product.title}
<br>
<a href="/pay/${product.slug}" style="color:#0f0">خرید فوری</a>
`;

document.body.appendChild(box);

}

});

}
</script>


