        const organizationSchema = {
            "@context": "https://schema.org",
            "@type": "Organization", // یا WebSite بسته به صفحه
            "url": window.location.origin,
            "name": "نام فروشگاه شما", // حتماً اسم فروشگاه خودتون رو بذارید
