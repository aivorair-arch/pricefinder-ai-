            "item" => $baseUrl
        ],
        [
            "@type" => "ListItem",
            "position" => 2,
            "name" => $category,
            "item" => $baseUrl . "/category.php?name=" . urlencode($category)
        ],
        [
            "@type" => "ListItem",
            "position" => 3,
            "name" => $name,
            "item" => $canonical
        ]
    ]
];

// -------------------------
