# 6️⃣ SEMANTIC INTERNAL LINKING v11  
لینک‌سازی هوشمند بین مقاله‌ها، محصولات، دسته‌ها

html
<script>
function v11SemanticLinks(words, products){

const relatedProducts = products
.filter(p => 
words.some(w => p.title.includes(w))
)
.slice(0,10);

const wrap=document.createElement("div");
wrap.className="v10-container";
wrap.innerHTML=`<h2>مطالب و محصولات مرتبط</h2>`;

relatedProducts.forEach(p=>{
const a=document.createElement("a");
a.href="/product/"+p.slug;
a.textContent=p.title;
a.style.display="block";
wrap.appendChild(a);
});

document.body.appendChild(wrap);

}
</script>


