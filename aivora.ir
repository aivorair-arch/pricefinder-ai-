# 6️⃣ REVENUE OPTIMIZATION AI

محصولات پرفروش را تشخیص می‌دهد.

html
<script>
function v12TopProducts(products){

let sales=JSON.parse(localStorage.getItem("v12_sales")||"{}");

return products
.map(p=>{
return{
product:p,
score:sales[p.slug]||0
};
})
.sort((a,b)=>b.score-a.score)
.slice(0,10)
.map(i=>i.product);

}
</script>


